# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (see README, "Switch the admin to GitHub mode").

# --- Optional site-wide password (HTTP Basic Auth) ---------------------------------
# Leave empty to disable. Any username works; only the password is checked.
SITE_PASSWORD=

# --- Keystatic admin storage --------------------------------------------------------
# Leave both empty for local mode (edits write files on your computer; use `npm run dev`).
# Set on Vercel to edit through GitHub: every Save becomes a commit and Vercel redeploys.
NEXT_PUBLIC_KEYSTATIC_STORAGE=        # "github" to switch on GitHub mode
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=    # owner/repo, e.g. yourname/learning-journey

# --- Keystatic GitHub App (only needed in GitHub mode) ------------------------------
# Keystatic writes these into .env when you first open /keystatic in GitHub mode locally
# and click "Create GitHub App". Copy the same values to Vercel.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
